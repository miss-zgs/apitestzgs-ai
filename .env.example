# ========================================
# 环境变量配置模板
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env
# ========================================


# ========================================
# Agent 配置（使用 agent_run.py 时需要）
# ========================================

# LLM API Key（中转站/OpenAI 兼容格式）
AGENT_API_KEY=your_api_key_here

# LLM API 地址（中转站地址）
AGENT_BASE_URL=https://api.meai.cloud

# 模型名称
AGENT_MODEL=claude-opus-4-7

# 模型温度（0-1，越低越稳定）
AGENT_TEMPERATURE=0.1

# ========================================
# API 服务认证（使用 agent_api.py 时需要）
# ========================================

# API 密钥，设置后调用 API 需要在请求头中携带 X-API-Key
API_KEY=your_api_key_here
